{
  "name": "@accordpay/contracts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "clean": "hardhat clean",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:giwa": "hardhat run scripts/deploy.ts --network giwaSepolia",
    "verify:giwa": "hardhat run scripts/verify.ts --network giwaSepolia",
    "dry-run": "hardhat run scripts/dry-run.ts --network hardhat",
    "export:abi": "ts-node scripts/export-abi.ts",
    "lint": "solhint \"contracts/**/*.sol\"",
    "security": "npm run compile && npm run lint && npm run test && npm run coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "3.1.2",
    "@nomicfoundation/hardhat-network-helpers": "1.1.2",
    "@nomicfoundation/hardhat-verify": "2.1.3",
    "@openzeppelin/contracts": "5.6.1",
    "@types/mocha": "10.0.10",
    "dotenv": "17.2.3",
    "ethers": "6.17.0",
    "hardhat": "2.28.6",
    "mocha": "11.7.5",
    "solidity-coverage": "0.8.17",
    "solhint": "6.2.3",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
