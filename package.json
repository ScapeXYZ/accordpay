{
  "name": "accordpay",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@accordpay/web",
    "build": "npm run build --workspace=@accordpay/web",
    "lint": "npm run lint --workspace=@accordpay/web",
    "test:lifecycle": "npm run test:lifecycle --workspace=@accordpay/web",
    "test:verification": "npm run test:verification --workspace=@accordpay/web",
    "test:names": "npm run test:names --workspace=@accordpay/web",
    "typecheck": "npm run typecheck --workspace=@accordpay/web",
    "contracts:compile": "npm run compile --workspace=@accordpay/contracts",
    "contracts:test": "npm run test --workspace=@accordpay/contracts",
    "contracts:coverage": "npm run coverage --workspace=@accordpay/contracts",
    "contracts:typecheck": "npm run typecheck --workspace=@accordpay/contracts",
    "contracts:lint": "npm run lint --workspace=@accordpay/contracts",
    "contracts:dry-run": "npm run dry-run --workspace=@accordpay/contracts",
    "contracts:security": "npm run security --workspace=@accordpay/contracts",
    "contracts:export-abi": "npm run export:abi --workspace=@accordpay/contracts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "eslint": "^9.39.2",
    "hardhat": "2.28.6",
    "prettier": "^3.9.6"
  }
}
