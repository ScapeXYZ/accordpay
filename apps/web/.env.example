# Dojang verification is read server-side from the official GIWA Sepolia RPC
# and DojangScroll contract. It requires no API key or browser-exposed secret.

# Server-only Ethereum Sepolia RPC used to cross-check ENS-compatible UP ID
# forward records.
# Use a provider appropriate for production traffic. Never expose a secret RPC key
# through a NEXT_PUBLIC_ variable.
UPBIT_NAMES_ETHEREUM_RPC_URL=

# Official GIWA Sepolia registry reads used for active-name ownership and reverse
# resolution. The public default may be rate-limited; configure a production
# provider when available.
UPBIT_NAMES_GIWA_RPC_URL=https://sepolia-rpc.giwa.io
UPBIT_NAMES_REGISTRY_ADDRESS=0x091D00004f21eb2Fc30964A8a4995692d9b49628
UPBIT_NAMES_CACHE_TTL_SECONDS=60
