# Dojang verification is read server-side from the official GIWA Sepolia RPC
# and DojangScroll contract. It requires no API key or browser-exposed secret.

# Server-only Ethereum Sepolia RPC used to cross-check ENS-compatible UP ID
# forward records.
# Use a provider appropriate for production traffic. Never expose a secret RPC key
# through a NEXT_PUBLIC_ variable.
UPBIT_NAMES_ETHEREUM_RPC_URL=

# Official GIWA Sepolia registry reads used for active-name ownership and reverse
# resolution. The public default may be rate-limited; configure a production
# provider when available.
UPBIT_NAMES_GIWA_RPC_URL=https://sepolia-rpc.giwa.io
UPBIT_NAMES_REGISTRY_ADDRESS=0x091D00004f21eb2Fc30964A8a4995692d9b49628
UPBIT_NAMES_CACHE_TTL_SECONDS=60

# Server-only persistent activity index. Required in production.
DATABASE_URL=

# Dedicated GIWA RPC recommended for production indexing. The public endpoint
# remains the development fallback and may be rate-limited.
GIWA_RPC_URL=https://sepolia-rpc.giwa.io

# Secret used by scheduled jobs calling POST /api/accordpay/sync.
GIWA_SYNC_SECRET=

# AccordPay Deal Rooms use the existing Supabase PostgreSQL project.
# DATABASE_URL must be a server-only pooled PostgreSQL connection.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=accordpay-private
SUPABASE_PUBLIC_METADATA_BUCKET=accordpay-public-metadata
SUPABASE_JWT_SECRET=

# Browser-safe Supabase project values used only for authenticated Realtime.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origin used when generating immutable AccordPay HTTPS metadata URIs.
APP_URL=http://localhost:3000

# Signed wallet sessions. Generate a random value of at least 32 characters.
WALLET_SESSION_SECRET=

# Optional staffed support. Authorization still comes only from the
# server-controlled support_agents table.
ACCORDPAY_SUPPORT_ENABLED=false

# Optional immutable/content-addressed metadata provider.
METADATA_STORAGE_PROVIDER=accordpay-immutable-https
IPFS_PROVIDER_URL=
IPFS_PROVIDER_TOKEN=
ARWEAVE_PROVIDER_URL=

# Optional assistant provider. The deterministic fallback requires neither.
AI_PROVIDER=deterministic
AI_API_KEY=
